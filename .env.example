# =============================================================================
# SOEZE.TECH — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
# DO NOT commit .env.local to git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SOEZE AI STUDIO ASSISTANT (FREE-TIER PROVIDERS)
# -----------------------------------------------------------------------------
# Choose your free AI provider: "groq" (recommended) or "gemini"
AI_PROVIDER=groq

# Primary Free Model Identifier:
# - For Groq: llama-3.3-70b-versatile (or llama-3.1-8b-instant)
# - For Gemini: gemini-2.0-flash (or gemini-1.5-flash)
AI_MODEL=llama-3.3-70b-versatile

# GROQ API KEY (Recommended free tier):
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# GOOGLE GEMINI API KEY (Alternative free tier):
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 2. CONTACT EMAIL CONFIGURATION (RESEND)
# -----------------------------------------------------------------------------
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# The inbox where visitor enquiries should be received (e.g. hello@soeze.tech)
CONTACT_TO_EMAIL=hello@soeze.tech

# Verified sender address in your Resend account (e.g. hello@soeze.tech)
CONTACT_FROM_EMAIL=hello@soeze.tech
